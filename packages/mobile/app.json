{
  "expo": {
    "name": "Confidence Trivia",
    "slug": "confidence-trivia",
    "scheme": "confidence-trivia",
    "version": "0.1.0",
    "orientation": "landscape",
    "backgroundColor": "#14101F",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "bundleIdentifier": "com.daniespi.confidencetrivia",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "package": "com.daniespi.confidencetrivia"
    },
    "plugins": [
      "expo-audio",
      "expo-secure-store",
      "expo-web-browser",
      "expo-apple-authentication"
    ],
    "extra": {
      "eas": {
        "projectId": "a0f50448-01fb-4a56-aa8f-4b822429acc2"
      }
    }
  }
}
