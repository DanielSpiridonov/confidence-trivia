{
  "expo": {
    "name": "Confidence Trivia",
    "slug": "confidence-trivia",
    "scheme": "confidence-trivia",
    "version": "0.1.0",
    "orientation": "landscape",
    "icon": "./assets/app-icon.png",
    "backgroundColor": "#14101F",
    "androidStatusBar": {
      "hidden": true,
      "translucent": true,
      "backgroundColor": "#14101F"
    },
    "androidNavigationBar": {
      "visible": "sticky-immersive",
      "barStyle": "light-content",
      "backgroundColor": "#14101F"
    },
    "splash": {
      "image": "./assets/loading-emblem.png",
      "resizeMode": "contain",
      "backgroundColor": "#14101F"
    },
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "bundleIdentifier": "com.daniespi.confidencetrivia",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/loading-emblem.png",
        "backgroundColor": "#32105F"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "package": "com.daniespi.confidencetrivia"
    },
    "plugins": [
      "expo-dev-client",
      "expo-audio",
      "expo-secure-store",
      "expo-web-browser",
      "expo-apple-authentication",
      [
        "expo-navigation-bar",
        {
          "visibility": "hidden",
          "behavior": "overlay-swipe",
          "legacyVisible": "sticky-immersive"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "a0f50448-01fb-4a56-aa8f-4b822429acc2"
      }
    }
  }
}
