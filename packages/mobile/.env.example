# Copy this file to .env.local, choose one URL, then restart Expo.

# Physical phones on the same Wi-Fi, with the server running locally:
EXPO_PUBLIC_SERVER_URL=ws://192.168.1.23:2567

# Physical phones anywhere, using the shared Render test server:
# EXPO_PUBLIC_SERVER_URL=wss://confidence-trivia-test.onrender.com

# Required for Google/Apple account linking (safe client-side publishable values):
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
